---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="bg-white py-20 sm:py-24 lg:py-32">
      <div class="mx-auto max-w-7xl px-6 sm:px-12 lg:px-24">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <SectionHeading
              eyebrow="Academic background"
              title="Education"
              accent={siteConfig.accentColor}
            />
          </div>

          <div class="space-y-6 lg:col-span-8">
            {siteConfig.education.map((edu) => (
              <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition-shadow duration-300 hover:shadow-md sm:p-6">
                <div class="mb-3 flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
                  <div>
                    <h3 class="text-lg font-semibold text-slate-900 sm:text-xl">
                      {edu.degree}
                    </h3>
                    <p
                      class="text-base font-medium sm:text-lg"
                      style={`color: ${siteConfig.accentColor}`}
                    >
                      {edu.school}
                    </p>
                  </div>
                  <span class="shrink-0 font-mono text-xs text-slate-500 sm:text-sm">
                    {edu.dateRange}
                  </span>
                </div>

                <ul class="space-y-2">
                  {edu.achievements.map((achievement) => (
                    <li class="flex items-start">
                      <span class="mr-3 mt-2 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-slate-300" />
                      <span class="text-sm leading-relaxed text-slate-600 sm:text-base">
                        {achievement}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
