---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section
      id="experience"
      class="bg-gray-50 px-8 py-20 sm:px-12 sm:py-24 md:px-16 lg:px-24 lg:py-32"
    >
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <SectionHeading
              eyebrow="Career history"
              title="Experience"
              accent={siteConfig.accentColor}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="relative">
              <span
                class="absolute bottom-2 left-[9px] top-2 w-px bg-gray-200"
                aria-hidden="true"
              ></span>

              <div class="space-y-8">
                {siteConfig.experience.map((exp) => (
                  <div class="relative pl-10">
                    <span
                      class="absolute left-0 top-2 flex h-[18px] w-[18px] items-center justify-center rounded-full border-2 bg-white"
                      style={`border-color: ${siteConfig.accentColor}`}
                      aria-hidden="true"
                    >
                      <span
                        class="h-[7px] w-[7px] rounded-full"
                        style={`background-color: ${siteConfig.accentColor}`}
                      />
                    </span>

                    <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition-shadow duration-300 hover:shadow-md">
                      <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                        <h3 class="text-lg font-semibold text-gray-900 sm:text-xl">
                          {exp.title}
                        </h3>
                        <span class="font-mono text-xs font-medium uppercase tracking-wider text-gray-400">
                          {exp.dateRange}
                        </span>
                      </div>

                      <p
                        class="mt-1 text-base font-medium"
                        style={`color: ${siteConfig.accentColor}`}
                      >
                        {exp.company}
                      </p>

                      <ul class="mt-4 space-y-2">
                        {exp.bullets.map((bullet) => (
                          <li class="flex items-start gap-3">
                            <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gray-300" />
                            <span class="text-sm text-gray-600 sm:text-base">
                              {bullet}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
