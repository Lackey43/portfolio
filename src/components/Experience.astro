---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="bg-slate-100 py-20 sm:py-24 lg:py-32">
      <div class="mx-auto max-w-7xl px-6 sm:px-12 lg:px-24">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <SectionHeading
              eyebrow="Career history"
              title="Experience"
              accent={siteConfig.accentColor}
            />
            <p class="mt-6 hidden max-w-xs text-sm leading-relaxed text-slate-600 lg:block">
              Marketing, HR, banking and procurement, most recent first.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="relative lg:-ml-10">
              {/* Left rail: one continuous line behind every dot */}
              <div class="absolute bottom-2 left-[7px] top-2 w-px bg-slate-200" />

              {siteConfig.experience.map((exp) => (
                <div class="relative mb-8 pl-10 last:mb-0">
                  {/* Timeline dot on the rail */}
                  <span
                    class="absolute left-0 top-1.5 z-10 h-4 w-4 rounded-full border-2 bg-white"
                    style={`border-color: ${siteConfig.accentColor}`}
                  />

                  <div class="rounded-2xl border border-slate-200/70 bg-white p-5 shadow-sm transition-shadow duration-300 hover:shadow-md sm:p-6">
                    <div class="mb-4 flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
                      <div>
                        <h3 class="text-lg font-semibold text-slate-900 sm:text-xl">
                          {exp.title}
                        </h3>
                        <p
                          class="text-base font-medium sm:text-lg"
                          style={`color: ${siteConfig.accentColor}`}
                        >
                          {exp.company}
                        </p>
                      </div>
                      <span class="shrink-0 font-mono text-xs text-slate-500 sm:text-sm">
                        {exp.dateRange}
                      </span>
                    </div>

                    <ul class="space-y-2">
                      {exp.bullets.map((bullet) => (
                        <li class="flex items-start">
                          <span class="mr-3 mt-2 inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-slate-300" />
                          <span class="text-sm leading-relaxed text-slate-600 sm:text-base">
                            {bullet}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
