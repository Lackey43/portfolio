---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
---

<section
  id="about"
  class="bg-white px-8 py-20 sm:px-12 sm:py-24 md:px-16 lg:px-24 lg:py-32"
>
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <SectionHeading
          eyebrow="Who I am"
          title="About Me"
          accent={siteConfig.accentColor}
        />
      </div>

      <div class="lg:col-span-8">
        <p class="text-lg leading-relaxed text-gray-600 sm:text-xl">
          {siteConfig.aboutMe}
        </p>

        <div class="mt-10 border-t border-gray-100 pt-8">
          <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-gray-400">
            Core skills
          </p>
          <div class="mt-4 flex flex-wrap gap-2.5">
            {
              siteConfig.skills.map((skill) => (
                <span class="rounded-full border border-gray-200 bg-gray-50 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:border-[var(--accent-color)] hover:text-[var(--accent-color)]">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
