---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
---

<section id="about" class="bg-white py-20 sm:py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-6 sm:px-12 lg:px-24">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <SectionHeading
          eyebrow="Who I am"
          title="About Me"
          accent={siteConfig.accentColor}
        />
      </div>

      <div class="space-y-8 lg:col-span-8">
        <p
          class="max-w-3xl text-pretty text-lg leading-relaxed text-slate-600 sm:text-xl"
        >
          {siteConfig.aboutMe}
        </p>

        <div class="rounded-2xl border border-slate-200/70 bg-slate-100/70 p-5 sm:p-7">
          <p
            class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-slate-600"
          >
            Skills
          </p>
          <ul class="mt-4 divide-y divide-slate-200/70 border-t border-slate-200/70">
            {
              siteConfig.skills.map((skill) => (
                <li class="flex items-start gap-3 py-2.5">
                  <span
                    class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full"
                    style={`background-color: ${siteConfig.accentColor}`}
                  />
                  <span class="text-sm leading-relaxed text-slate-700 sm:text-base">
                    {skill}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
