---
import { siteConfig } from "../config";

const social = siteConfig.social ?? {};
const availability = siteConfig.availability;
---

<div
  id="hero"
  class="relative isolate flex min-h-screen items-center overflow-hidden bg-white px-8 pb-20 pt-32 sm:px-12 md:px-16 lg:px-24"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <!-- Accent wash -->
  <div
    class="absolute inset-0 -z-10"
    style={`background: radial-gradient(ellipse 900px 1000px at 6% 0%, ${siteConfig.accentColor}21 0%, ${siteConfig.accentColor}12 35%, rgba(255,255,255,0) 70%)`}
  >
  </div>

  <!-- Dot grid -->
  <div
    class="absolute inset-0 -z-10"
    style={`background-image: radial-gradient(${siteConfig.accentColor}26 1px, transparent 1px); background-size: 22px 22px; mask-image: radial-gradient(ellipse 55% 55% at 28% 28%, black 8%, transparent 72%); -webkit-mask-image: radial-gradient(ellipse 55% 55% at 28% 28%, black 8%, transparent 72%);`}
  >
  </div>

  <div class="mx-auto grid w-full max-w-7xl items-center gap-14 md:grid-cols-2 md:gap-12">
    <!-- Text -->
    <div class="animate-fade-in">
      {
        availability && (
          <span class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white/70 px-3.5 py-1.5 text-xs font-medium text-gray-700 backdrop-blur">
            <span class="relative flex h-2 w-2">
              <span
                class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-60"
                style={`background-color: ${siteConfig.accentColor}`}
              />
              <span
                class="relative inline-flex h-2 w-2 rounded-full"
                style={`background-color: ${siteConfig.accentColor}`}
              />
            </span>
            {availability}
          </span>
        )
      }

      <p
        class="mt-6 font-mono text-xs font-semibold uppercase tracking-[0.25em] sm:text-sm"
        style={`color: ${siteConfig.accentColor}`}
      >
        Hello, I'm
      </p>
      <h1
        class="mt-3 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl md:text-6xl lg:text-7xl"
      >
        {siteConfig.name}
      </h1>
      <p
        class="mt-4 text-pretty text-lg font-medium text-gray-600 sm:text-xl md:text-2xl"
      >
        {siteConfig.title}
      </p>

      <!-- Call to action -->
      <div class="mt-8 flex animate-fade-in flex-wrap items-center gap-4 animation-delay-200">
        {
          social.email && (
            <a
              href={`mailto:${social.email}`}
              class="inline-flex items-center gap-2 rounded-full bg-gray-900 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-gray-700"
            >
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.9 5.3a2 2 0 002.2 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                />
              </svg>
              Contact me
            </a>
          )
        }
        {
          social.linkedin && (
            <a
              href={social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-gray-300 px-6 py-3 text-sm font-semibold text-gray-700 transition-colors hover:border-gray-900 hover:text-gray-900"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.3c0-1.26-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9z" />
              </svg>
              LinkedIn
            </a>
          )
        }
      </div>
    </div>

    <!-- Profile photo -->
    <div class="flex animate-fade-in justify-center animation-delay-200 md:justify-end">
      <div class="relative">
        <div
          class="absolute -inset-6 -z-10 rounded-full opacity-30 blur-3xl"
          style={`background: ${siteConfig.accentColor}`}
        >
        </div>
        <img
          src="profile.png"
          alt={siteConfig.name}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          oncontextmenu="return false;"
          ondragstart="return false;"
          draggable="false"
          class="h-56 w-56 rounded-full border-8 border-white object-cover shadow-2xl ring-4 ring-[var(--accent-color)] transition-transform duration-500 hover:scale-105 sm:h-64 sm:w-64 md:h-80 md:w-80"
        />
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <a
    href="#about"
    class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-gray-400 transition-colors hover:text-gray-700 md:inline-flex"
    aria-label="Scroll to content"
  >
    Scroll
    <svg
      class="h-3.5 w-3.5 animate-bounce"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </a>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
    opacity: 0;
  }
  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in {
      animation: none;
      opacity: 1;
    }
  }
</style>
