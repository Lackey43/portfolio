---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasmarketingCreatives =
  siteConfig.marketingCreatives && siteConfig.marketingCreatives.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const hasCertificates =
  siteConfig.certifications && siteConfig.certifications.length > 0;

const links = [
  { href: "#about", label: "About", show: true },
  { href: "#projects", label: "Projects", show: hasProjects },
  {
    href: "#marketing-creatives",
    label: "Creatives",
    show: hasmarketingCreatives,
  },
  { href: "#experience", label: "Experience", show: hasExperience },
  { href: "#education", label: "Education", show: hasEducation },
  { href: "#certificates", label: "Certificates", show: hasCertificates },
].filter((link) => link.show);

const social = siteConfig.social ?? {};
const year = new Date().getFullYear();
---

<footer
  class="bg-gray-900 text-gray-400"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div class="mx-auto max-w-7xl px-6 py-16 sm:px-12 lg:px-24">
    <!-- Call to action -->
    <div
      class="flex flex-col gap-8 border-b border-white/10 pb-12 md:flex-row md:items-end md:justify-between"
    >
      <div>
        <p
          class="font-mono text-xs font-semibold uppercase tracking-[0.25em]"
          style={`color: ${siteConfig.accentColor}`}
        >
          Get in touch
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Let's work together
        </h2>
        <p class="mt-3 max-w-md text-gray-400">
          Have a project or a role in mind? I'd love to hear about it.
        </p>
      </div>

      {
        social.email && (
          <a
            href={`mailto:${social.email}`}
            class="inline-flex items-center gap-2 self-start rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-gray-900 transition-colors hover:bg-gray-200 md:self-auto"
          >
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.9 5.3a2 2 0 002.2 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              />
            </svg>
            Get in touch
          </a>
        )
      }
    </div>

    <!-- Details -->
    <div class="grid grid-cols-1 gap-10 pt-12 md:grid-cols-2">
      <div>
        <p class="text-lg font-bold text-white">{siteConfig.name}</p>
        <p class="mt-2 text-sm text-gray-400">{siteConfig.title}</p>

        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
          {
            social.email && (
              <a
                href={`mailto:${social.email}`}
                class="inline-flex items-center gap-2 transition-colors hover:text-white"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 8l7.9 5.3a2 2 0 002.2 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  />
                </svg>
                Email
              </a>
            )
          }
          {
            social.linkedin && (
              <a
                href={social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 transition-colors hover:text-white"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.3c0-1.26-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9z" />
                </svg>
                LinkedIn
              </a>
            )
          }
          {
            social.github && (
              <a
                href={social.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 transition-colors hover:text-white"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.48v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.9-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.4 9.4 0 015 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9v2.82c0 .27.18.59.69.48A10.01 10.01 0 0022 12.25C22 6.58 17.52 2 12 2z" />
                </svg>
                GitHub
              </a>
            )
          }
        </div>
      </div>

      <nav class="flex flex-wrap gap-x-8 gap-y-3 md:justify-end">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-sm transition-colors hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-white/10 pt-8 text-sm text-gray-500"
    >
      <span>© {year} {siteConfig.name}. All rights reserved.</span>
      <a href="#hero" class="transition-colors hover:text-white">
        Back to top ↑
      </a>
    </div>
  </div>
</footer>
