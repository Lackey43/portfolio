---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section
      id="projects"
      class="bg-gray-50 px-8 py-20 sm:px-12 sm:py-24 md:px-16 lg:px-24 lg:py-32"
    >
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <SectionHeading
              eyebrow="Selected work"
              title="Projects"
              accent={siteConfig.accentColor}
            />
          </div>

          <div class="space-y-6 lg:col-span-8">
            {siteConfig.projects.map((project, index) => (
              <div class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-xl sm:p-8">
                <span
                  class="absolute left-0 top-0 h-full w-1 origin-top scale-y-0 transition-transform duration-300 group-hover:scale-y-100"
                  style={`background-color: ${siteConfig.accentColor}`}
                  aria-hidden="true"
                />

                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                  <div class="flex items-start gap-4">
                    <span
                      class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg font-mono text-sm font-semibold"
                      style={`color: ${siteConfig.accentColor}; background-color: ${siteConfig.accentColor}14`}
                    >
                      {String(index + 1).padStart(2, "0")}
                    </span
                    >
                    <h3 class="pt-1 text-xl font-bold text-gray-900 sm:text-2xl">
                      {project.name}
                    </h3>
                  </div>

                  {project.links && project.links.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {project.links.map((link) => (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 px-3 py-1.5 text-xs font-medium text-gray-700 transition-colors hover:border-gray-900 hover:bg-gray-900 hover:text-white sm:text-sm"
                        >
                          {link.name}
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-3.5 w-3.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L9 15"
                            />
                          </svg>
                        </a>
                      ))}
                    </div>
                  )}
                </div>

                <p class="mt-4 max-w-3xl text-base leading-relaxed text-gray-600">
                  {project.description}
                </p>

                {project.skills && project.skills.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {project.skills.map((skill) => (
                      <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600 sm:text-sm">
                        {skill}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
