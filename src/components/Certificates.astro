---
import { siteConfig } from "../config";

const hasCertificates = siteConfig.certifications && siteConfig.certifications.length > 0;
---

{
  hasCertificates && (
    <section id="certificates" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div class="mb-12">
        <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
          Certificates
        </h2>

            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          {/* Right Content */}
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
              {siteConfig.certifications.map((cert) => (
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-shadow duration-300">

                <a
                  href={cert.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <img
                    src={cert.image}
                    alt={cert.title}
                    class="w-full h-56 object-cover hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </a>

                  <div class="p-5">
                    <h3 class="text-lg font-semibold text-gray-900">
                      {cert.title}
                    </h3>

                    <p
                      class="mt-1"
                      style={`color: ${siteConfig.accentColor}`}
                    >
                      {cert.issuer}
                    </p>

                    <p class="text-sm text-gray-500 mt-1">
                      {cert.date}
                    </p>
                  </div>

                </div>
              ))}
            </div>
          </div>
    </section>
  )
}