---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";

const hasCertificates =
  siteConfig.certifications && siteConfig.certifications.length > 0;
---

{
  hasCertificates && (
    <section
      id="certificates"
      class="bg-gray-50 px-8 py-20 sm:px-12 sm:py-24 md:px-16 lg:px-24 lg:py-32"
    >
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <SectionHeading
              eyebrow="Credentials"
              title="Certificates"
              accent={siteConfig.accentColor}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="grid gap-6 sm:grid-cols-2 sm:gap-8">
              {siteConfig.certifications.map((cert) => (
                <a
                  href={cert.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-gray-300 hover:shadow-xl"
                >
                  <div class="flex items-center justify-center border-b border-gray-100 bg-gray-50 p-4">
                    <img
                      src={cert.image}
                      alt={cert.title}
                      class="h-40 w-full object-contain transition-transform duration-300 group-hover:scale-[1.03]"
                      loading="lazy"
                    />
                  </div>

                  <div class="flex flex-1 flex-col p-5">
                    <h3 class="text-base font-semibold text-gray-900">
                      {cert.title}
                    </h3>

                    <p
                      class="mt-1 text-sm font-medium"
                      style={`color: ${siteConfig.accentColor}`}
                    >
                      {cert.issuer}
                    </p>

                    <p class="mt-auto pt-3 font-mono text-xs uppercase tracking-wider text-gray-400">
                      {cert.date}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
