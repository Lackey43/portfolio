---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";

const hasCreatives =
  siteConfig.marketingCreatives && siteConfig.marketingCreatives.length > 0;
const creatives = siteConfig.marketingCreatives ?? [];
// Only centre the trailing card when the count is odd, otherwise it strands its pair.
const centreLast = creatives.length % 2 === 1;
const cardBase =
  "group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-slate-300 hover:shadow-xl hover:shadow-slate-900/5";
const cardCentred = centreLast
  ? " sm:last:col-span-2 sm:last:mx-auto sm:last:w-[calc(50%-0.75rem)]"
  : "";
---

{
  hasCreatives && (
    <section id="marketing-creatives" class="bg-white py-20 sm:py-24 lg:py-32">
      <div class="mx-auto max-w-7xl px-6 sm:px-12 lg:px-24">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <SectionHeading
              eyebrow="Marketing"
              title="Marketing Creatives"
              accent={siteConfig.accentColor}
            />
            <p class="mt-6 hidden max-w-xs text-sm leading-relaxed text-slate-600 lg:block">
              Lead magnets, landing pages and social posts. Open a card to view
              the asset as a client would see it.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="grid gap-4 sm:grid-cols-2 sm:gap-6">
              {creatives.map((creative) => (
                <a
                  href={creative.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={cardBase + cardCentred}
                >
                  <div class="relative overflow-hidden border-b border-slate-100 bg-slate-100" style="aspect-ratio: 4 / 5">
                    {creative.video ? (
                      <video
                        src={creative.video}
                        poster={creative.poster}
                        class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
                        muted
                        loop
                        playsinline
                        preload="none"
                        data-card-video
                      ></video>
                    ) : (
                      <img
                        src={creative.image}
                        alt={creative.title}
                        class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                      />
                    )}
                    {creative.video && (
                      <span class="pointer-events-none absolute bottom-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-slate-900/70 px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-widest text-white backdrop-blur">
                        <span aria-hidden="true">▶</span> Reel
                      </span>
                    )}
                  </div>

                  <div class="flex flex-1 flex-col p-5">
                    <p
                      class="font-mono text-xs font-semibold uppercase tracking-[0.15em]"
                      style={`color: ${siteConfig.accentColor}`}
                    >
                      {creative.category}
                    </p>

                    <h3 class="mt-2 text-base font-bold leading-snug text-slate-900 sm:text-lg">
                      {creative.title}
                    </h3>

                    <div class="mt-auto flex flex-wrap gap-2 pt-4">
                      {creative.tools.map((tool) => (
                        <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 ring-1 ring-slate-200/60">
                          {tool}
                        </span>
                      ))}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  // Play a card's video only while it is on screen. Five clips playing at once
  // would burn bandwidth and CPU for nothing. Plain JS on purpose: a generic
  // type argument in an inline Astro script is not reliably stripped in dev.
  const cardVideos = Array.from(document.querySelectorAll("[data-card-video]"));
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (cardVideos.length > 0 && !reducedMotion) {
    const playSafe = (video) => {
      const attempt = video.play();
      if (attempt && typeof attempt.catch === "function") attempt.catch(() => {});
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) playSafe(entry.target);
            else entry.target.pause();
          });
        },
        { threshold: 0.35 },
      );
      cardVideos.forEach((video) => observer.observe(video));
    } else {
      cardVideos.forEach(playSafe);
    }
  }
</script>
