---
interface Props {
  eyebrow: string;
  title: string;
  accent: string;
}

const { eyebrow, title, accent } = Astro.props;
---

<div>
  <p
    class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.2em]"
    style={`color: ${accent}`}
  >
    <span class="h-px w-6" style={`background-color: ${accent}`}></span>
    {eyebrow}
  </p>
  <h2
    class="mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl md:text-5xl"
  >
    {title}
  </h2>
  <div
    class="mt-4 h-[5px] w-[75px] rounded-full"
    style={`background-color: ${accent}`}
  >
  </div>
</div>
